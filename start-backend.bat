@echo off
REM ============================================================================
REM  Mobile Mall - Start Backend Server (port 3002)
REM  Double-click this file, then open http://localhost:3002/api/health
REM  ============================================================================
REM
REM  WHY ENGLISH COMMENTS ONLY:
REM  Windows cmd reads .bat files with the legacy console code page.
REM  Chinese text becomes mojibake and can crash the parser.
REM  See README.md and 运行步骤.txt for the Chinese instructions.
REM ============================================================================

cd /d "%~dp0"

echo.
echo ============================================================
echo   Mobile Mall Backend  (port 3002)
echo ============================================================
echo.

REM ---- Check Node.js -------------------------------------------------------
where node >nul 2>nul
if %errorlevel% neq 0 (
    echo [ERROR] Node.js is not installed or not in PATH.
    echo Get it from https://nodejs.org then reopen this window.
    echo.
    pause
    exit /b 1
)

echo [OK] Node.js found:
node -v
echo.

REM ---- Check dependencies --------------------------------------------------
if not exist "node_modules" (
    echo [WARN] node_modules not found. Running npm install first...
    echo This takes 30-60 seconds. Please wait.
    echo.
    npm install
    if %errorlevel% neq 0 (
        echo.
        echo [ERROR] npm install failed.
        echo Common fixes:
        echo   1. Check your network, try again
        echo   2. Right-click this file and "Run as administrator"
        echo.
        pause
        exit /b 1
    )
)

REM ---- Check seed data -----------------------------------------------------
REM data/products.json is generated by `npm run seed`.
REM It is only a fallback: the server fetches 190+ live products on start and
REM refreshes every 5 minutes. Uncomment the next line to disable the live
REM source and use the local seed data only.
REM set MOBI_LIVE=0
if not exist "data\products.json" (
    echo [WARN] data\products.json not found. Generating seed data...
    echo.
    npm run seed
    if %errorlevel% neq 0 (
        echo.
        echo [ERROR] npm run seed failed.
        echo.
        pause
        exit /b 1
    )
)

echo.
echo Starting backend...
echo   Health check : http://localhost:3002/api/health
echo   Products API : http://localhost:3002/api/products?page=1^&pageSize=8
echo.
echo If dist\ exists, the full site is also served at http://localhost:3002/
echo Keep this window OPEN while using the app.
echo Press Ctrl+C to stop.
echo.

node server/api-server.js

echo.
echo Backend stopped.
pause
